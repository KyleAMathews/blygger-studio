+/** Actual unmutated unit counts and normalized capture records, never estimates. */
+export function baselinePassReceipt(name, files, oracleFiles, pass, relative) {
+  const baseline = files.map((file) => {
+    const unit = pass.units.find((unit) => unit.file === file)
+    const tests = unit?.tests ?? []
+    return {
+      file: relative(file),
+      ordinary: !oracleFiles.has(file),
+      ...(pass.failed.has(file) ? { failure: pass.failed.get(file) } : {}),
+      passed: tests.filter((test) => test.state === `passed`).length,
+      failed: tests.filter((test) => test.state === `failed`).length,
+      skipped: tests.filter((test) => test.state === `skipped`).length,
+    }
+  })
+  const capture = [...pass.rows].filter(([, row]) => !row.background).map(([key, row]) => {
+    const at = key.indexOf(` > `)
+    return {
+      ...row,
+      key: at < 0 ? relative(key) : relative(key.slice(0, at)) + key.slice(at),
+    }
+  })
+  return { name, baseline, capture,
+    captureSha256: createHash(`sha256`).update(JSON.stringify(capture)).digest(`hex`) }
+}
+
+/** A baseline completion must never claim that zero mutation gaps were found. */
+export function renderBaselineOnly(report, paths) {
+  const lines = [
+    streamLine(`summary`, `${report.run.id}: baseline-only check; ${report.oracleFiles.length} oracle files, two unmutated passes; mutation audit not run.`),
+  ]
+  for (const pass of report.baselinePasses) {
+    for (const row of pass.baseline)
+      lines.push(streamLine(`baseline`, `${pass.name} ${row.failure || row.failed ? `fail` : `pass`} ${row.file}: ${row.passed} passed, ${row.failed} failed, ${row.skipped} skipped${row.failure ? `; ${escapeControls(row.failure)}` : ``}`))
+  }
+  if (report.nondeterministic.length)
+    lines.push(streamLine(`note`, `nondeterministic: ${report.nondeterministic.map(escapeControls).join(`, `)}`))
+  lines.push(
+    streamLine(`note`, `No mutation was judged. This report cannot establish gap closure; run the full check without --baseline-only for a mutation audit.`),
+    streamLine(`note`, `results ${escapeControls(posix(paths.results))}`),
+    streamLine(`done`, `baseline-completed${report.provisional ? ` (provisional)` : ``}, report ${paths.report}`),
+  )
+  return lines.join(`\n`)
+}
